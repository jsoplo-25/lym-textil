# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND - TEXTILES L&M
# ==============================================================================
# Para desarrollo LOCAL: Copia este archivo como .env
# Para DESPLIEGUE (Vercel): Configura estas variables en el panel de Vercel
# ==============================================================================

# URL del Backend API:
# - En LOCAL: http://localhost:4000/api/v1
# - En PRODUCCIÓN / VERCEL: https://lym-textil.onrender.com/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Credenciales de Supabase (Cliente)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Configuración de Sesión e Inactividad
VITE_INACTIVITY_MINUTES=15
VITE_WARNING_MINUTES=2
