# ==============================================================================
# AMBIENTE: PRODUCCIÓN (PRODUCTION) - RENDER
# ==============================================================================
# Configurar estas variables en el Web Service de Render para Producción
# ==============================================================================

NODE_ENV=production
PORT=10000

# Backend y Frontend URLs de Producción
API_URL=https://textil-lym-backend.onrender.com
FRONTEND_URL=https://textil-lym.vercel.app,https://www.textil-lym.com

# Supabase (Proyecto Producción)
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY=your-prod-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-supabase-service-role-key

# Database Supabase Producción
DATABASE_URL=postgresql://postgres.your-prod-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-prod-project:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# JWT (Generar claves criptográficamente seguras para Producción)
JWT_SECRET=prod_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=prod_super_secure_refresh_secret_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d
