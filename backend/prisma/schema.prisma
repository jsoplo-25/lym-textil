// Prisma Schema for Textil L&M Backend System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// MODELS
// ==========================================

model RoleDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]

  @@map("roles")
}

model User {
  id             String          @id @default(uuid())
  workerId       String          @unique @map("worker_id")
  email          String          @unique
  passwordHash   String          @map("password_hash")
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  role           String          @default("ADMINISTRADOR")
  roleDefinition RoleDefinition? @relation(fields: [role], references: [code], onDelete: Restrict, onUpdate: Cascade)
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  phone          String?
  jobTitle       String?         @map("job_title")
  avatarUrl      String?         @map("avatar_url")
  lastLoginAt    DateTime?       @map("last_login_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  startedRolls    ProductionRoll[] @relation("RollStartOperator")
  endedRolls      ProductionRoll[] @relation("RollEndOperator")
  batchStatusLogs BatchStatusLog[]

  @@map("users")
}

model Machine {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  type         String   @default("Costura")
  brand        String?
  model        String?
  serialNumber String?  @map("serial_number")
  status       String   @default("OPERATIVE") // OPERATIVE, MAINTENANCE, OUT_OF_SERVICE
  designTypes  String[] @default([]) @map("design_types") // Dray, Win, etc.
  location     String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  productionBatches ProductionBatch[]

  @@map("machines")
}

model Supplier {
  id          String   @id @default(uuid())
  document    String   @unique // RUC / DNI
  name        String   // Razón Social
  phone       String?
  email       String?
  address     String?
  yarnTypes   String[] @default([]) @map("yarn_types") // Lista de tipos de hilo suministrados
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productionBatches ProductionBatch[]

  @@map("suppliers")
}

model ProductionBatch {
  id           String          @id @default(uuid())
  batchNumber  String          @unique @map("batch_number")
  trackingCode String?         @unique @map("tracking_code")
  machineId    String          @map("machine_id")
  machine      Machine         @relation(fields: [machineId], references: [id], onDelete: Restrict)
  machineCode  String?         @map("machine_code")
  machineName  String?         @map("machine_name")
  supplierId   String          @map("supplier_id")
  supplier     Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName String?         @map("supplier_name")
  startDate    DateTime        @default(now()) @map("start_date")
  endDate      DateTime?       @map("end_date")
  status       String          @default("REQUESTED") // REQUESTED, IN_PROGRESS, PAUSED, COMPLETED
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  yarns        BatchYarn[]
  rolls        ProductionRoll[]
  statusLogs   BatchStatusLog[]

  @@map("production_batches")
}

model BatchStatusLog {
  id              String          @id @default(uuid())
  batchId         String          @map("batch_id")
  batch           ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status          String
  changedByUserId String?         @map("changed_by_user_id")
  changedByUser   User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("batch_status_logs")
}

model BatchYarn {
  id           String          @id @default(uuid())
  batchId      String          @map("batch_id")
  batch        ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  yarnName     String          @map("yarn_name")
  color        String?
  lotCode      String?         @map("lot_code")
  rollCount    Int?            @default(0) @map("roll_count")
  totalWeight  Float?          @default(0) @map("total_weight")
  status       String          @default("IN_PREPARATION")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  rolls        ProductionRoll[]

  @@map("batch_yarns")
}

model ProductionRoll {
  id              String          @id @default(uuid())
  batchId         String          @map("batch_id")
  batch           ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  yarnId          String?         @map("yarn_id")
  yarn            BatchYarn?      @relation(fields: [yarnId], references: [id], onDelete: SetNull)
  yarnName        String?         @map("yarn_name")
  rollNumber      String          @map("roll_number")
  startDate       String          @map("start_date")
  startTime       String          @map("start_time")
  startOperatorId String          @map("start_operator_id")
  startOperatorRel User           @relation("RollStartOperator", fields: [startOperatorId], references: [id], onDelete: Restrict)
  startOperator   String?         @map("start_operator")
  endDate         String?         @map("end_date")
  endTime         String?         @map("end_time")
  endOperatorId   String?         @map("end_operator_id")
  endOperatorRel  User?           @relation("RollEndOperator", fields: [endOperatorId], references: [id], onDelete: SetNull)
  endOperator     String?         @map("end_operator")
  weight          Float?
  status          String          @default("REGISTERED") // REGISTERED, IN_PREPARATION, READY_FOR_APPROVAL, READY_FOR_PICKUP, DELIVERED
  observations    String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([batchId, rollNumber], map: "idx_rolls_batch_roll_number")
  @@map("production_rolls")
}
