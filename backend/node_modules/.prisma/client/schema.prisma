// Prisma Schema for Textil L&M Backend System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// MODELS
// ==========================================

model RoleDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  role           String          @default("OPERATOR")
  roleDefinition RoleDefinition? @relation(fields: [role], references: [code], onDelete: Restrict, onUpdate: Cascade)
  avatarUrl      String?         @map("avatar_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model Machine {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  type         String   @default("Costura")
  brand        String?
  model        String?
  serialNumber String?  @map("serial_number")
  status       String   @default("OPERATIVE") // OPERATIVE, MAINTENANCE, OUT_OF_SERVICE
  location     String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  productionBatches ProductionBatch[]

  @@map("machines")
}

model Supplier {
  id        String   @id @default(uuid())
  document  String   @unique // RUC / DNI
  name      String // Razón Social / Nombre del proveedor
  phone     String?
  email     String?
  address   String?
  yarnTypes String?  @map("yarn_types") // Tipos de hilos suministrados (ej. Algodón 30/1, Poliéster)
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productionBatches ProductionBatch[]

  @@map("suppliers")
}

model ProductionBatch {
  id           String    @id @default(uuid())
  batchNumber  String    @map("batch_number")
  trackingCode String?   @unique @map("tracking_code")
  machineId    String?   @map("machine_id")
  machine      Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineCode  String?   @map("machine_code")
  machineName  String?   @map("machine_name")
  supplierId   String?   @map("supplier_id")
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?   @map("supplier_name")
  startDate    DateTime? @default(now()) @map("start_date")
  endDate      DateTime? @map("end_date")
  status       String    @default("REQUESTED") // REQUESTED ("Solicitud registrada"), COMPLETED ("Terminado")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  yarns BatchYarn[]
  rolls ProductionRoll[]

  @@map("production_batches")
}

model BatchYarn {
  id          String          @id @default(uuid())
  batchId     String          @map("batch_id")
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  yarnName    String          @map("yarn_name") // ej. Algodón 30/1, Poliéster 24/1
  color       String? // ej. Crudo, Melange, Azul Marino
  lotCode     String?         @map("lot_code") // Partida / Código de lote de hilo del proveedor
  rollCount   Int?            @default(0) @map("roll_count") // Rollos producidos
  totalWeight Float?          @default(0) @map("total_weight") // Kilos
  status      String          @default("IN_PREPARATION") // IN_PREPARATION ("En preparación"), READY_FOR_PICKUP ("Listo para recojo"), DELIVERED ("Entregado")
  notes       String? // Avances semanales o notas
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  rolls ProductionRoll[]

  @@map("batch_yarns")
}

model ProductionRoll {
  id            String          @id @default(uuid())
  batchId       String          @map("batch_id")
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  yarnId        String?         @map("yarn_id")
  yarn          BatchYarn?      @relation(fields: [yarnId], references: [id], onDelete: SetNull)
  yarnName      String?         @map("yarn_name")
  rollNumber    String          @map("roll_number")
  startDate     String?         @map("start_date")
  startTime     String?         @map("start_time")
  startOperator String?         @map("start_operator")
  endDate       String?         @map("end_date")
  endTime       String?         @map("end_time")
  endOperator   String?         @map("end_operator")
  weight        Float?
  status        String          @default("REGISTERED") // REGISTERED, IN_PREPARATION, READY_FOR_PICKUP, DELIVERED
  observations  String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("production_rolls")
}
