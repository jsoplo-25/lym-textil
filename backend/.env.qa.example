# ==============================================================================
# AMBIENTE: PRUEBAS / QA (STAGING / QA) - RENDER
# ==============================================================================
# Configurar estas variables en el Web Service de Render para QA/Staging
# ==============================================================================

NODE_ENV=qa
PORT=10000

# Backend y Frontend URLs de QA
API_URL=https://textil-lym-backend-qa.onrender.com
FRONTEND_URL=https://qa.textil-lym.vercel.app,https://textil-lym-*-qa.vercel.app

# Supabase (Proyecto QA / Staging)
SUPABASE_URL=https://your-qa-project.supabase.co
SUPABASE_ANON_KEY=your-qa-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-qa-supabase-service-role-key

# Database Supabase QA
DATABASE_URL=postgresql://postgres.your-qa-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-qa-project:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=qa_jwt_secret_key_textiles_lym_secure_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=qa_jwt_refresh_secret_key_textiles_lym_2026
JWT_REFRESH_EXPIRES_IN=7d
