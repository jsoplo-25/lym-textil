# ==============================================================================
# CONFIGURACIÓN GENERAL DEL BACKEND - TEXTILES L&M
# ==============================================================================
# - En LOCAL: Este archivo sirve de plantilla para tu 'backend/.env'
# - En DESPLIEGUE (Render): Configura estas variables en Render Dashboard > Environment
# ==============================================================================

# Entorno y Puerto
# - En LOCAL: development / 4000
# - En RENDER: production / 10000 (Render asigna PORT automáticamente)
NODE_ENV=development
PORT=4000

# URLs del Backend y Frontend (Para CORS y Swagger Docs)
# - En LOCAL:
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# - En RENDER:
# API_URL=https://lym-textil.onrender.com
# FRONTEND_URL=* (o https://textil-lym.vercel.app,https://*.vercel.app)

# Credenciales de Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Conexión a Base de Datos PostgreSQL (Supabase)
# DATABASE_URL: Puerto 6543 (Transaction Pooler - Recomendado para Serverless/Render) o 5432
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Puerto 5432 (Conexión Directa para migraciones con Prisma)
DIRECT_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_textiles_lym_2026_intellecta
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_textiles_lym_2026
JWT_REFRESH_EXPIRES_IN=7d

# Servicio de Correo Electrónico (Para recuperación de contraseña)
# - Opción Resend (Recomendado, gratuito hasta 3,000 correos/mes): https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Textiles L&M <no-reply@textileslym.com>
# - Opción SMTP tradicional (opcional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion

# WhatsApp Cloud API (Meta for Developers)
# Obtén tus credenciales en developers.facebook.com > WhatsApp > Configuración de la API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
