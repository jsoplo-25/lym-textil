# ==========================================
# Textil L&M - Global Git Ignore
# ==========================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnpm-store/
.yarn/cache/

# 2. Environment Variables & Credentials
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# 3. Production & Build Outputs
dist/
dist-ssr/
**/dist/
**/dist-ssr/
build/
out/

# 4. Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
**/.DS_Store

# 6. IDEs & Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# 7. TypeScript & Bundler Cache
*.tsbuildinfo
**/*.tsbuildinfo
.eslintcache
.turbo/
.cache/

# 8. AI Agent Workspaces
.agents/
.cursor/
.claude/
.devin/
